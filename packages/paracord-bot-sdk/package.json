{
  "name": "@paracord/bot-sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for building Paracord bots.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "paracord",
    "bot",
    "sdk",
    "typescript",
    "gateway",
    "rest"
  ],
  "license": "MIT"
}

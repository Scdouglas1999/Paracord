{
  "name": "paracord-client",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run typecheck && npm run test:unit && npm run test:tokens && npm run test:motion-lint",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:a11y:static": "node ./scripts/a11y-static-audit.mjs",
    "test:contrast": "node ./scripts/contrast-audit.mjs",
    "test:tokens": "node ./scripts/literal-color-audit.mjs",
    "test:motion-lint": "node ./scripts/motion-lint.mjs",
    "test:e2e": "playwright test",
    "test:motion": "PARACORD_E2E_MOTION=1 playwright test",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "contracts:export": "cargo run --locked -j 2 --manifest-path ../Cargo.toml -p paracord-contracts --bin export-contracts -- ../contracts/api-contracts.json",
    "contracts:generate": "npm run contracts:export && node scripts/generate-api-contracts.mjs",
    "contracts:check": "node scripts/generate-api-contracts.mjs --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/gabarito": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "@tanstack/react-virtual": "^3.10.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.0.0",
    "dompurify": "^3.3.1",
    "fflate": "^0.8.2",
    "highlight.js": "^11.11.1",
    "livekit-client": "^2.17.1",
    "lucide-react": "^0.563.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "fast-uri": "^3.1.4",
    "postcss": "^8.5.23"
  }
}

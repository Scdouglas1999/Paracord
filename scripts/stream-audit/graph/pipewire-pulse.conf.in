# The pulse API of the private graph @NAME@ (the app's stream-audio router
# drives it through pactl, and its capture reads through libpulse), on a socket
# in the audit's own directory, never the user's.
context.properties = { }
context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}
context.modules = [
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
    { name = libpipewire-module-metadata }
    { name = libpipewire-module-protocol-pulse args = { } }
]
stream.properties = { }
pulse.properties = {
    server.address = [ "unix:@PULSE@" ]
}
